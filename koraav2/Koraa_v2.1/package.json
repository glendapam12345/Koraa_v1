{
  "name": "koraa_v2.1",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/worklets-shim.js",
    "dev": "REACT_NATIVE_PACKAGER_PORT=8081 EXPO_NO_TELEMETRY=1 expo start --port 8081",
    "dev:clear": "REACT_NATIVE_PACKAGER_PORT=8081 EXPO_NO_TELEMETRY=1 expo start --port 8081 --clear",
    "dev:fresh": "rm -rf .expo node_modules/.cache 2>/dev/null; REACT_NATIVE_PACKAGER_PORT=8081 EXPO_NO_TELEMETRY=1 expo start --port 8081 --clear",
    "dev:tunnel": "REACT_NATIVE_PACKAGER_PORT=8081 EXPO_NO_TELEMETRY=1 expo start --port 8081 --tunnel",
    "dev:bolt": "npm run dev",
    "build:web": "expo export --platform web",
    "publish": "eas update --auto",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:supabase": "node scripts/check-supabase-env.mjs",
    "check:supabase:migrations": "node scripts/supabase-migrations-hint.mjs",
    "env:bootstrap": "node scripts/env-bootstrap.mjs",
    "verify:local": "npm run check:supabase && npm run check:supabase:migrations",
    "supabase:email-otp-templates": "node scripts/update-supabase-otp-email-templates.mjs",
    "supabase:email_otp_templates": "node scripts/update-supabase-otp-email-templates.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config jest.config.simple.js",
    "test:hooks": "jest --config jest.config.hooks.js",
    "start": "npx -y node@20 ./node_modules/expo/bin/cli start --port 8081",
    "start:clear": "npx -y node@20 ./node_modules/expo/bin/cli start --port 8081 --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx -y node@20 ./node_modules/expo/bin/cli start --android --port 8081",
    "ios": "npx -y node@20 ./node_modules/expo/bin/cli start --ios --port 8081",
    "web": "npx -y node@20 ./node_modules/expo/bin/cli start --web --port 8081"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/libre-baskerville": "^0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.103.3",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "@react-navigation/elements": "^2.6.3",
    "expo-image": "~3.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "react-native-worklets": "0.5.1"
  }
}
