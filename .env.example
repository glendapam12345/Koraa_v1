# =============================================================================
# Koraa — variables de entorno (NO subas .env a git; solo .env.example)
# =============================================================================
#
# Paso 1 — Crear .env
#   cp .env.example .env
#   O: npm run env:bootstrap
#
# Paso 2 — Rellenar Supabase (mismo proyecto para URL y clave)
#   Dashboard: https://supabase.com/dashboard → tu proyecto → Settings → API
#   - "Project URL"     → EXPO_PUBLIC_SUPABASE_URL
#   - "anon" "public"   → EXPO_PUBLIC_SUPABASE_ANON_KEY  (NUNCA la service_role)
#
# Paso 3 — Base de datos
#   En Supabase → SQL Editor, ejecuta las migraciones del repo en orden.
#   Referencia: npm run check:supabase:migrations
#   Guía: development_guidelines/learnings/SUPABASE_SCHEMA_AND_MIGRATIONS.md
#
# Paso 4 — Reiniciar Metro tras cambiar .env
#   npm run dev:clear
#
# Comprobar conectividad: npm run check:supabase
# Comprobar todo lo anterior + lista SQL: npm run verify:local
#
# --- Solo scripts locales (plantillas correo OTP en Supabase) ---
# NO es la anon key. Token personal: https://supabase.com/dashboard/account/tokens
# Tras definirlo: npm run supabase:email-otp-templates
# SUPABASE_ACCESS_TOKEN=
# Opcional si la URL no está en .env:
# SUPABASE_PROJECT_REF=tu_project_ref
# =============================================================================

# --- Obligatorio para la app ---
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZA_CON_TU_ANON_PUBLIC

# --- Opcional: analítica (Fase D — tabla app_events en Supabase) ---
# EXPO_PUBLIC_ANALYTICS_ENABLED=false

# --- RevenueCat (recomendado para pruebas y obligatorio en release) ---
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_REEMPLAZA_CON_TU_PUBLIC_SDK_KEY
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_REEMPLAZA_SI_APLICA

# --- Opcional (pantalla Ayuda /help y paywall: enlaces legales) ---
# Ejemplo producción (Lovable): privacidad y términos públicos
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://koradelcaosalacalma.lovable.app/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://koradelcaosalacalma.lovable.app/terms
